---
// Hero section - two-column layout with ambient glow and interactive image carousel
---

<section id="hero" class="relative py-28 md:py-40 lg:py-48 overflow-hidden">
  <!-- Subtle background grid pattern -->
  <div class="absolute inset-0 bg-grid-pattern pointer-events-none" aria-hidden="true"></div>

  <!-- Ambient glowing blobs (visible in dark mode for premium aesthetics) -->
  <div class="absolute -top-20 left-1/4 w-[500px] h-[500px] rounded-full blur-[120px] opacity-[0.03] dark:opacity-[0.08] glow-blob-1 pointer-events-none" aria-hidden="true"></div>
  <div class="absolute top-1/3 right-10 w-[400px] h-[400px] rounded-full blur-[100px] opacity-[0.02] dark:opacity-[0.06] glow-blob-2 pointer-events-none animate-pulse" style="animation-duration: 12s;" aria-hidden="true"></div>

  <div class="section-container relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Left Column: Biography & CTAs (7 columns on large screens) -->
      <div class="lg:col-span-7 flex flex-col items-start text-left">
        <!-- Mono badge -->
        <span 
          class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-[var(--color-accent-300)]/20 dark:border-[var(--color-accent-700)]/30 bg-[var(--color-accent-500)]/5 text-[var(--color-accent-500)] font-mono text-[10px] font-bold uppercase tracking-widest mb-6 animate-fade-in"
          style="animation-delay: 0.1s;"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-accent-500)] animate-pulse"></span>
          Formal Methods &times; ML Systems
        </span>

        <!-- Name with Gradient -->
        <h1 
          class="text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight mb-6 animate-fade-in-up" 
          style="animation-delay: 0.2s;"
        >
          <span class="bg-gradient-to-r from-[var(--color-text-primary)] via-[var(--color-accent-500)] to-[var(--color-accent-600)] bg-clip-text text-transparent animate-gradient">
            Ryan Peters
          </span>
        </h1>

        <!-- Subhead -->
        <p 
          class="text-xl md:text-2xl text-[var(--color-text-secondary)] font-light leading-relaxed mb-8 animate-fade-in-up" 
          style="animation-delay: 0.35s;"
        >
          M.S. Computer Science student at Syracuse University, working at the intersection of formal methods and machine learning systems.
        </p>

        <!-- Lead sentence -->
        <p 
          class="text-base md:text-lg text-[var(--color-text-tertiary)] leading-relaxed mb-10 animate-fade-in-up max-w-[62ch]" 
          style="animation-delay: 0.5s;"
        >
          I use formal specification (<span class="font-mono text-sm px-1.5 py-0.5 rounded border border-[var(--color-border)] bg-[var(--color-surface-secondary)] text-[var(--color-text-secondary)]">TLA+</span>) as a discovery tool: writing precise specs of distributed training protocols to surface optimization opportunities that an implementation-first view misses, not just to verify correctness after the fact.
        </p>

        <!-- CTAs with interactive scales -->
        <div class="flex flex-wrap gap-4 animate-fade-in-up" style="animation-delay: 0.65s;">
          <a
            href="https://github.com/rpeters4"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-[var(--color-text-primary)] text-[var(--color-text-inverse)] text-sm font-semibold shadow-md hover:bg-neutral-800 dark:hover:bg-neutral-200 hover:shadow-lg active:scale-95 transition-all duration-200 cursor-pointer"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            GitHub
          </a>

          <a
            href="https://www.linkedin.com/in/rynptrs/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl border border-[var(--color-border)] text-[var(--color-text-primary)] text-sm font-semibold bg-[var(--color-surface-card)]/50 backdrop-blur-sm hover:border-[var(--color-border-hover)] hover:bg-[var(--color-surface-secondary)] active:scale-95 transition-all duration-200 cursor-pointer"
          >
            <svg class="w-4 h-4 text-sky-600 dark:text-sky-400" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
            LinkedIn
          </a>

          <a
            href="mailto:rpeter01@syr.edu"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl border border-[var(--color-border)] text-[var(--color-text-primary)] text-sm font-semibold bg-[var(--color-surface-card)]/50 backdrop-blur-sm hover:border-[var(--color-border-hover)] hover:bg-[var(--color-surface-secondary)] active:scale-95 transition-all duration-200 cursor-pointer"
          >
            <svg class="w-4 h-4 text-violet-600 dark:text-violet-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            Email
          </a>
        </div>
      </div>

      <!-- Right Column: Image Carousel (5 columns on large screens) -->
      <div class="lg:col-span-5 w-full flex justify-center animate-fade-in-up" style="animation-delay: 0.8s;">
        <div class="relative w-full max-w-[340px] md:max-w-[360px] aspect-[4/5] rounded-3xl border border-[var(--color-border)] bg-[var(--color-surface-card)] shadow-2xl p-2.5 overflow-hidden group">
          
          <!-- Carousel Slides Container -->
          <div class="relative w-full h-full rounded-2xl overflow-hidden bg-[var(--color-surface-secondary)]">
            
            <!-- Slide 1: Fountain (img2) - Displays First -->
            <div class="carousel-slide absolute inset-0 opacity-100 transition-all duration-700 ease-in-out scale-100 z-10">
              <img 
                src="/ryan-fountain.jpg" 
                alt="Ryan Peters standing by a fountain in front of a church" 
                class="w-full h-full object-cover object-center pointer-events-none select-none"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent"></div>
              <div class="absolute bottom-4 left-4 right-4 text-white">
                <p class="font-mono text-[9px] uppercase tracking-widest text-white/90 font-bold">Rome, Italy</p>
              </div>
            </div>

            <!-- Slide 2: Concert (img1) - Displays Second -->
            <div class="carousel-slide absolute inset-0 opacity-0 transition-all duration-700 ease-in-out scale-95 z-0">
              <img 
                src="/ryan-concert.jpg" 
                alt="Ryan Peters attending a live concert wearing a black metal shirt" 
                class="w-full h-full object-cover object-center pointer-events-none select-none"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent"></div>
              <div class="absolute bottom-4 left-4 right-4 text-white">
                <p class="font-mono text-[9px] uppercase tracking-widest text-white/90 font-bold">Live Show</p>
              </div>
            </div>

          </div>

          <!-- Slide Navigation Arrows -->
          <button 
            id="carousel-prev" 
            class="absolute left-6 top-1/2 -translate-y-1/2 w-9 h-9 flex items-center justify-center rounded-full bg-black/40 backdrop-blur-md text-white hover:bg-black/60 active:scale-90 transition-all shadow opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-20 cursor-pointer"
            aria-label="Previous image"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
          </button>
          
          <button 
            id="carousel-next" 
            class="absolute right-6 top-1/2 -translate-y-1/2 w-9 h-9 flex items-center justify-center rounded-full bg-black/40 backdrop-blur-md text-white hover:bg-black/60 active:scale-90 transition-all shadow opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-20 cursor-pointer"
            aria-label="Next image"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </button>

          <!-- Indicator Dots -->
          <div class="absolute bottom-6 left-1/2 -translate-x-1/2 flex items-center gap-2 z-20">
            <button class="carousel-dot w-2 h-2 rounded-full bg-white/50 hover:bg-white transition-all duration-300 cursor-pointer" data-slide-index="0" aria-label="Go to slide 1"></button>
            <button class="carousel-dot w-2 h-2 rounded-full bg-white/50 hover:bg-white transition-all duration-300 cursor-pointer" data-slide-index="1" aria-label="Go to slide 2"></button>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<script>
  function initCarousel() {
    const slides = document.querySelectorAll('.carousel-slide');
    const dots = document.querySelectorAll('.carousel-dot');
    const prevBtn = document.getElementById('carousel-prev');
    const nextBtn = document.getElementById('carousel-next');

    if (!slides.length || !dots.length) return;

    let currentIndex = 0;
    let autoPlayTimer: number | undefined;

    function updateCarousel(index: number) {
      currentIndex = (index + slides.length) % slides.length;
      
      slides.forEach((slide, i) => {
        const isActive = i === currentIndex;
        slide.classList.toggle('opacity-100', isActive);
        slide.classList.toggle('scale-100', isActive);
        slide.classList.toggle('z-10', isActive);
        
        slide.classList.toggle('opacity-0', !isActive);
        slide.classList.toggle('scale-95', !isActive);
        slide.classList.toggle('z-0', !isActive);
      });

      dots.forEach((dot, i) => {
        const isActive = i === currentIndex;
        dot.classList.toggle('bg-white', isActive);
        dot.classList.toggle('w-5', isActive); // Shimmering width expand effect
        dot.classList.toggle('bg-white/50', !isActive);
      });
    }

    function startAutoPlay() {
      stopAutoPlay();
      autoPlayTimer = window.setInterval(() => {
        updateCarousel(currentIndex + 1);
      }, 5500);
    }

    function stopAutoPlay() {
      if (autoPlayTimer) {
        clearInterval(autoPlayTimer);
      }
    }

    prevBtn?.addEventListener('click', () => {
      stopAutoPlay();
      updateCarousel(currentIndex - 1);
      startAutoPlay();
    });

    nextBtn?.addEventListener('click', () => {
      stopAutoPlay();
      updateCarousel(currentIndex + 1);
      startAutoPlay();
    });

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const indexStr = dot.getAttribute('data-slide-index');
        if (indexStr !== null) {
          stopAutoPlay();
          updateCarousel(parseInt(indexStr, 10));
          startAutoPlay();
        }
      });
    });

    // Initialize first display
    updateCarousel(0);
    startAutoPlay();
  }

  // Load handler
  initCarousel();
  document.addEventListener('astro:after-swap', initCarousel);
</script>
