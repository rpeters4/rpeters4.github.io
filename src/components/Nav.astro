---
import ThemeToggle from './ThemeToggle.astro';

const navLinks = [
  { href: '#about', label: 'About' },
  { href: '#research', label: 'Research' },
  { href: '#skills', label: 'Skills' },
  { href: '#projects', label: 'Projects' },
  { href: '#contact', label: 'Contact' },
];
---

<header
  id="site-nav"
  class="fixed top-4 left-0 right-0 z-50 w-full flex flex-col items-center px-4 pointer-events-none transition-all duration-300"
>
  <nav 
    class="pointer-events-auto flex items-center justify-between w-full max-w-3xl h-14 px-6 rounded-full border border-[var(--color-border)] bg-[var(--color-surface-card)]/75 backdrop-blur-md shadow-lg transition-all duration-300" 
    aria-label="Main navigation"
  >
    <!-- Logo / Name -->
    <a href="#hero" class="font-mono text-sm font-bold tracking-wider text-[var(--color-text-primary)] hover:text-[var(--color-accent-500)] transition-colors">
      RP
    </a>

    <!-- Desktop nav links -->
    <div class="hidden md:flex items-center gap-1">
      {navLinks.map(link => (
        <a
          href={link.href}
          class="nav-link px-3.5 py-1.5 text-xs font-semibold tracking-wider uppercase text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] rounded-full transition-all duration-200"
          data-nav-link
        >
          {link.label}
        </a>
      ))}
      <div class="ml-3 pl-3 border-l border-[var(--color-border)] flex items-center">
        <ThemeToggle />
      </div>
    </div>

    <!-- Mobile menu button -->
    <div class="flex items-center gap-2 md:hidden">
      <ThemeToggle />
      <button
        id="mobile-menu-btn"
        type="button"
        aria-label="Toggle menu"
        aria-expanded="false"
        class="flex items-center justify-center w-8 h-8 rounded-full border border-[var(--color-border)] bg-[var(--color-surface-card)] hover:border-[var(--color-border-hover)] transition-all cursor-pointer"
      >
        <svg id="menu-icon-open" class="w-4 h-4 text-[var(--color-text-secondary)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-icon-close" class="w-4 h-4 text-[var(--color-text-secondary)] hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="md:hidden hidden absolute top-16 left-4 right-4 pointer-events-auto border border-[var(--color-border)] bg-[var(--color-surface-card)]/90 backdrop-blur-xl rounded-2xl shadow-xl transition-all duration-300 overflow-hidden"
  >
    <div class="p-3 flex flex-col gap-1">
      {navLinks.map(link => (
        <a
          href={link.href}
          class="mobile-nav-link px-4 py-3 text-sm font-semibold uppercase tracking-wider text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] rounded-xl hover:bg-[var(--color-surface-secondary)] transition-all duration-200"
          data-nav-link
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
</header>

<!-- Spacer for fixed nav -->
<div class="h-20"></div>

<script>
  function initNav() {
    // Mobile menu toggle
    const menuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');

    menuBtn?.addEventListener('click', () => {
      const isOpen = mobileMenu?.classList.toggle('hidden') === false;
      menuBtn.setAttribute('aria-expanded', String(isOpen));
      iconOpen?.classList.toggle('hidden', isOpen);
      iconClose?.classList.toggle('hidden', !isOpen);
    });

    // Close mobile menu on link click
    document.querySelectorAll('.mobile-nav-link').forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu?.classList.add('hidden');
        menuBtn?.setAttribute('aria-expanded', 'false');
        iconOpen?.classList.remove('hidden');
        iconClose?.classList.add('hidden');
      });
    });

    // Scroll-spy: highlight active section
    const navLinks = document.querySelectorAll('[data-nav-link]');
    const sections = document.querySelectorAll('section[id]');

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute('id');
            navLinks.forEach(link => {
              const href = link.getAttribute('href');
              const isActive = href === `#${id}`;
              link.classList.toggle('text-[var(--color-accent-500)]', isActive);
              link.classList.toggle('bg-[var(--color-surface-secondary)]', isActive);
              link.classList.toggle('text-[var(--color-text-secondary)]', !isActive);
            });
          }
        });
      },
      {
        rootMargin: '-30% 0px -60% 0px',
        threshold: 0,
      }
    );

    sections.forEach(section => observer.observe(section));
  }

  initNav();
  document.addEventListener('astro:after-swap', initNav);
</script>
