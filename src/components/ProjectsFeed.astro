---
// ProjectsFeed - client-side island that fetches from GitHub API
// Hydrated with client:visible, redesigned with next-gen grid items
---

<div id="projects-feed">
  <!-- Loading skeleton -->
  <div id="projects-loading" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {Array.from({ length: 6 }).map(() => (
      <div class="card animate-pulse flex flex-col justify-between h-48 border-[var(--color-border)] bg-[var(--color-surface-card)]">
        <div>
          <div class="h-4.5 bg-[var(--color-border)] rounded-md w-3/4 mb-4"></div>
          <div class="space-y-2 mb-4">
            <div class="h-3 bg-[var(--color-border)] rounded w-full"></div>
            <div class="h-3 bg-[var(--color-border)] rounded w-5/6"></div>
          </div>
        </div>
        <div class="flex items-center justify-between pt-3 border-t border-[var(--color-border)]/40">
          <div class="flex gap-3">
            <div class="h-3 bg-[var(--color-border)] rounded w-16"></div>
            <div class="h-3 bg-[var(--color-border)] rounded w-10"></div>
          </div>
          <div class="h-3 bg-[var(--color-border)] rounded w-16"></div>
        </div>
      </div>
    ))}
  </div>

  <!-- Redesigned Filter pills container -->
  <div id="projects-filters" class="hidden flex-wrap items-center gap-2 mb-8 animate-fade-in" style="animation-delay: 0.1s;"></div>

  <!-- Cards container -->
  <div id="projects-cards" class="hidden grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"></div>

  <!-- Redesigned Error fallback -->
  <div id="projects-error" class="hidden flex justify-center py-6">
    <a
      href="https://github.com/rpeters4"
      target="_blank"
      rel="noopener noreferrer"
      class="card inline-flex items-center gap-4 hover:border-[var(--color-accent-500)] max-w-md w-full shadow-sm"
    >
      <div class="w-10 h-10 flex items-center justify-center rounded-xl bg-[var(--color-accent-500)]/10 text-[var(--color-accent-500)]">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
      </div>
      <div>
        <span class="block text-sm font-bold text-[var(--color-text-primary)]">Connection Rate Limit Exceeded</span>
        <span class="block text-xs text-[var(--color-text-tertiary)]">Click here to view my projects directly on GitHub</span>
      </div>
    </a>
  </div>
</div>

<script>
  // Language colors from GitHub
  const LANG_COLORS: Record<string, string> = {
    JavaScript: '#f1e05a',
    TypeScript: '#3178c6',
    Python: '#3572A5',
    Rust: '#dea584',
    Go: '#00ADD8',
    Java: '#b07219',
    'C++': '#f34b7d',
    C: '#555555',
    'C#': '#239120',
    Ruby: '#701516',
    PHP: '#4F5D95',
    Swift: '#fa7343',
    Kotlin: '#A97BFF',
    Scala: '#c22d40',
    Racket: '#3c5caa',
    Scheme: '#1e4aec',
    OCaml: '#3be133',
    Haskell: '#5e5086',
    Shell: '#89e051',
    HTML: '#e34c26',
    CSS: '#563d7c',
    Astro: '#ff5a03',
    Lean: '#000000',
    'TLA+': '#a7a7a7',
  };

  const FEATURED: string[] = [];
  const CACHE_KEY = 'gh-repos-rpeters4';
  const API_URL = 'https://api.github.com/users/rpeters4/repos?per_page=100&sort=updated';

  interface GitHubRepo {
    name: string;
    full_name: string;
    html_url: string;
    description: string | null;
    language: string | null;
    stargazers_count: number;
    fork: boolean;
    archived: boolean;
    pushed_at: string;
    topics: string[];
  }

  function relativeTime(dateStr: string): string {
    const now = Date.now();
    const then = new Date(dateStr).getTime();
    const diff = now - then;
    const mins = Math.floor(diff / 60000);
    const hours = Math.floor(diff / 3600000);
    const days = Math.floor(diff / 86400000);
    const weeks = Math.floor(days / 7);
    const months = Math.floor(days / 30);
    const years = Math.floor(days / 365);

    if (mins < 1) return 'just now';
    if (mins < 60) return `${mins}m ago`;
    if (hours < 24) return `${hours}h ago`;
    if (days < 7) return `${days}d ago`;
    if (weeks < 5) return `${weeks}w ago`;
    if (months < 12) return `${months}mo ago`;
    return `${years}y ago`;
  }

  function renderCard(repo: GitHubRepo): string {
    const langDot = repo.language
      ? `<span class="inline-flex items-center gap-1.5 text-xs text-[var(--color-text-secondary)] font-mono font-medium">
           <span class="w-2 h-2 rounded-full flex-shrink-0" style="background-color: ${LANG_COLORS[repo.language] || '#8b8b8b'}"></span>
           ${repo.language}
         </span>`
      : '';

    const stars = repo.stargazers_count > 0
      ? `<span class="inline-flex items-center gap-1 text-xs text-[var(--color-text-secondary)] font-mono">
           <svg class="w-3.5 h-3.5 text-amber-500 fill-amber-500" viewBox="0 0 20 20" fill="currentColor">
             <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
           </svg>
           ${repo.stargazers_count}
         </span>`
      : '';

    return `
      <a href="${repo.html_url}" target="_blank" rel="noopener noreferrer"
         class="card flex flex-col justify-between group h-[200px]" data-lang="${repo.language || ''}"
         aria-label="View ${repo.name} on GitHub">
        <div>
          <div class="flex items-center justify-between mb-2">
            <h3 class="font-mono text-sm font-bold text-[var(--color-text-primary)] group-hover:text-[var(--color-accent-500)] transition-colors truncate">
              ${repo.name}
            </h3>
            <svg class="w-4 h-4 text-[var(--color-text-tertiary)] group-hover:text-[var(--color-accent-500)] group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </div>
          ${repo.description ? `<p class="text-sm text-[var(--color-text-secondary)] leading-relaxed line-clamp-3 mb-4">${repo.description}</p>` : '<p class="text-sm text-[var(--color-text-tertiary)] italic mb-4">No description</p>'}
        </div>
        <div class="flex items-center justify-between pt-3.5 border-t border-[var(--color-border)]/40">
          <div class="flex items-center gap-3">
            ${langDot}
            ${stars}
          </div>
          <span class="text-[10px] font-mono text-[var(--color-text-tertiary)]">${relativeTime(repo.pushed_at)}</span>
        </div>
      </a>
    `;
  }

  function renderFilters(languages: string[], activeFilter: string | null, onFilter: (lang: string | null) => void) {
    const filtersEl = document.getElementById('projects-filters');
    if (!filtersEl) return;

    filtersEl.innerHTML = '';
    filtersEl.classList.remove('hidden');
    filtersEl.classList.add('flex');

    // "All" pill button
    const allBtn = document.createElement('button');
    allBtn.type = 'button';
    allBtn.textContent = 'All';
    allBtn.className = `px-4 py-1.5 rounded-full text-xs font-mono font-bold transition-all cursor-pointer ${
      activeFilter === null
        ? 'bg-[var(--color-accent-500)] text-white shadow-sm'
        : 'bg-[var(--color-surface-card)] border border-[var(--color-border)] text-[var(--color-text-secondary)] hover:border-[var(--color-border-hover)] hover:scale-[1.03]'
    }`;
    allBtn.addEventListener('click', () => onFilter(null));
    filtersEl.appendChild(allBtn);

    languages.forEach(lang => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = `px-4 py-1.5 rounded-full text-xs font-mono font-bold transition-all cursor-pointer inline-flex items-center gap-2 ${
        activeFilter === lang
          ? 'bg-[var(--color-accent-500)] text-white shadow-sm'
          : 'bg-[var(--color-surface-card)] border border-[var(--color-border)] text-[var(--color-text-secondary)] hover:border-[var(--color-border-hover)] hover:scale-[1.03]'
      }`;
      const dot = document.createElement('span');
      dot.className = 'w-1.5 h-1.5 rounded-full';
      dot.style.backgroundColor = LANG_COLORS[lang] || '#8b8b8b';
      btn.appendChild(dot);
      btn.appendChild(document.createTextNode(lang));
      btn.addEventListener('click', () => onFilter(lang));
      filtersEl.appendChild(btn);
    });
  }

  async function initProjectsFeed() {
    const loadingEl = document.getElementById('projects-loading');
    const cardsEl = document.getElementById('projects-cards');
    const errorEl = document.getElementById('projects-error');

    try {
      let repos: GitHubRepo[];
      const cached = sessionStorage.getItem(CACHE_KEY);

      if (cached) {
        repos = JSON.parse(cached);
      } else {
        const res = await fetch(API_URL);
        if (!res.ok) throw new Error(`GitHub API error: ${res.status}`);
        repos = await res.json();
        sessionStorage.setItem(CACHE_KEY, JSON.stringify(repos));
      }

      repos = repos.filter(r => !r.fork && !r.archived);

      repos.sort((a, b) => {
        const aFeat = FEATURED.indexOf(a.name);
        const bFeat = FEATURED.indexOf(b.name);
        if (aFeat !== -1 && bFeat !== -1) return aFeat - bFeat;
        if (aFeat !== -1) return -1;
        if (bFeat !== -1) return 1;
        if (b.stargazers_count !== a.stargazers_count) return b.stargazers_count - a.stargazers_count;
        return new Date(b.pushed_at).getTime() - new Date(a.pushed_at).getTime();
      });

      const languages = [...new Set(repos.map(r => r.language).filter(Boolean) as string[])].sort();
      let activeFilter: string | null = null;

      function render() {
        if (!cardsEl) return;
        const filtered = activeFilter
          ? repos.filter(r => r.language === activeFilter)
          : repos;
        cardsEl.innerHTML = filtered.map(renderCard).join('');
        renderFilters(languages, activeFilter, (lang) => {
          activeFilter = lang;
          render();
        });
      }

      loadingEl?.classList.add('hidden');
      cardsEl?.classList.remove('hidden');
      cardsEl?.classList.add('grid');

      render();
    } catch (err) {
      console.warn('GitHub API fetch failed:', err);
      loadingEl?.classList.add('hidden');
      errorEl?.classList.remove('hidden');
    }
  }

  initProjectsFeed();
  document.addEventListener('astro:after-swap', initProjectsFeed);
</script>
