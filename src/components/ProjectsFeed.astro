---
// ProjectsFeed - curated featured project cards (static, no GitHub API).
// Only the four selected projects are shown to keep the section focused.

interface Project {
  title: string;
  badge: string;
  description: string;
  tech: string[];
  link: string;
  linkAvailable: boolean; // false if the repo is private/404
}

const projects: Project[] = [
  {
    title: 'Cross-Market Agricultural Commodity Prediction Engine',
    badge: 'Contributed (lead developer)',
    description:
      'An explainable-AI dashboard for livestock and commodity markets, with real-time XGBoost forecasting (time-series cross-validation and feature-importance explainability), a cross-market correlation engine over aligned USDA, CME, and FRED data, and plain-language briefings from a privacy-preserving local Llama-3-8B.',
    tech: ['Python', 'Streamlit', 'XGBoost', 'llama-cpp-python', 'pandas'],
    link: 'https://github.com/lsgracias/pro_ag_comp',
    linkAvailable: false, // repo is currently private (returns 404)
  },
  {
    title: 'Multi-Agent Restaurant & Activity Finder',
    badge: 'Contributed',
    description:
      'A location-aware, chat-first recommender built on a multi-agent architecture (an orchestrator coordinating parallel food and activity agents) with a scrape-to-ChromaDB retrieval pipeline and anti-hallucination prompting.',
    tech: ['Python', 'Streamlit', 'OpenAI', 'Google Places API', 'ChromaDB'],
    link: 'https://github.com/lsgracias/IST488Final',
    linkAvailable: true,
  },
  {
    title: 'AI Education Tool',
    badge: 'Contributed',
    description:
      'A multimodal tool that converts document pages into audio using image captioning (BLIP) and OCR (EasyOCR), where I contributed the memory and performance work: lazy model loading, a redesigned audio UI, and robust error handling.',
    tech: ['Python', 'BLIP', 'EasyOCR'],
    link: 'https://github.com/NEXIS-Syracuse/AI-Education-Spring-2026',
    linkAvailable: true,
  },
  {
    title: 'Collaborative Media Review Tool',
    badge: 'Created',
    description:
      'A SyncSketch-style frame-accurate media review and annotation app with WebGL canvas rendering and a containerized setup.',
    tech: ['Vue 3', 'Pixi.js', 'Docker'],
    link: 'https://github.com/rpeters4/collab-viewer',
    linkAvailable: true,
  },
];
---

<div id="projects-feed">
  <!-- Curated cards grid -->
  <div id="projects-cards" class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {projects.map((project, idx) => (
      <div
        class="project-card card flex flex-col justify-between group"
        style={`animation: fade-in-up 0.6s ease-out ${0.1 + idx * 0.1}s both;`}
      >
        <div>
          <!-- Header: title + external-link icon -->
          <div class="flex items-start justify-between mb-3 gap-3">
            <h3 class="font-semibold text-base text-[var(--color-text-primary)] leading-snug">
              {project.title}
            </h3>
            {project.linkAvailable && (
              <a
                href={project.link}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`View ${project.title} on GitHub`}
                class="mt-0.5 flex-shrink-0 text-[var(--color-text-tertiary)] hover:text-[var(--color-accent-500)] transition-colors"
              >
                <svg class="w-4 h-4 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            )}
          </div>

          <!-- Role badge -->
          <span class="inline-block mb-3 px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold uppercase tracking-wider border border-[var(--color-accent-500)]/30 bg-[var(--color-accent-500)]/8 text-[var(--color-accent-500)]">
            {project.badge}
          </span>

          <!-- Description -->
          <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed mb-4">
            {project.description}
          </p>
        </div>

        <!-- Footer: tech pills + repo link -->
        <div class="pt-3.5 border-t border-[var(--color-border)]/40">
          <div class="flex flex-wrap gap-1.5 mb-3">
            {project.tech.map(t => (
              <span class="inline-block px-2 py-0.5 rounded-md text-[10px] font-mono font-semibold border border-[var(--color-border)] bg-[var(--color-surface-secondary)]/60 text-[var(--color-text-secondary)]">
                {t}
              </span>
            ))}
          </div>

          {project.linkAvailable ? (
            <a
              href={project.link}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-xs font-mono font-semibold text-[var(--color-accent-500)] hover:text-[var(--color-accent-400)] transition-colors"
            >
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
              View on GitHub
            </a>
          ) : (
            <span class="inline-flex items-center gap-1.5 text-xs font-mono text-[var(--color-text-tertiary)]">
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                <path d="M7 11V7a5 5 0 0110 0v4" />
              </svg>
              Private repository
            </span>
          )}
        </div>
      </div>
    ))}
  </div>

  <!-- "View all" quiet link -->
  <div class="flex justify-center mt-10">
    <a
      href="https://github.com/rpeters4"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 text-sm font-mono text-[var(--color-text-tertiary)] hover:text-[var(--color-accent-500)] transition-colors group/link"
    >
      View all projects on GitHub
      <svg class="w-4 h-4 group-hover/link:translate-x-0.5 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </a>
  </div>
</div>
