---
// ResearchViz - Pipeline parallelism visualization
// Shows naive vs 1F1B scheduling to illustrate how formal analysis reveals idle gaps
---

<div class="card overflow-hidden relative border-[var(--color-border)] shadow-md" id="research-viz">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
    <div>
      <h3 class="font-mono text-sm font-bold tracking-wide text-[var(--color-text-primary)] mb-1.5 flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-[var(--color-accent-500)]"></span>
        Pipeline Parallelism Scheduling
      </h3>
      <p class="text-xs text-[var(--color-text-tertiary)] max-w-md">
        Visualizing how formal analysis exposes idle time (bubbles) in pipeline schedules.
      </p>
    </div>
    
    <!-- Redesigned Capsule Selector Toggle -->
    <div class="flex items-center gap-1 p-1.5 rounded-full bg-[var(--color-surface-secondary)] border border-[var(--color-border)] self-start sm:self-auto">
      <button
        id="viz-btn-naive"
        type="button"
        class="viz-toggle-btn px-4.5 py-1.5 rounded-full text-xs font-mono font-bold transition-all cursor-pointer bg-[var(--color-accent-500)] text-white shadow"
        aria-pressed="true"
      >
        Naive
      </button>
      <button
        id="viz-btn-1f1b"
        type="button"
        class="viz-toggle-btn px-4.5 py-1.5 rounded-full text-xs font-mono font-bold transition-all cursor-pointer text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)]"
        aria-pressed="false"
      >
        1F1B
      </button>
    </div>
  </div>

  <!-- SVG Pipeline Visualization -->
  <div class="w-full overflow-x-auto -mx-1 px-1">
    <svg id="pipeline-svg" viewBox="0 0 800 260" class="w-full min-w-[600px] select-none" role="img" aria-label="Pipeline parallelism schedule visualization showing micro-batch execution across pipeline stages over time">
      <!-- Gradient definitions for SVG blocks -->
      <defs>
        <linearGradient id="fwd-grad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="oklch(0.68 0.16 260)" />
          <stop offset="100%" stop-color="oklch(0.55 0.20 270)" />
        </linearGradient>
        <linearGradient id="bwd-grad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="oklch(0.70 0.14 150)" />
          <stop offset="100%" stop-color="oklch(0.58 0.16 160)" />
        </linearGradient>
        <pattern id="bubble-pattern" patternUnits="userSpaceOnUse" width="8" height="8" patternTransform="rotate(45)">
          <line x1="0" y1="0" x2="0" y2="8" stroke="var(--color-border-hover)" stroke-width="1.5" />
        </pattern>
      </defs>

      <!-- Y-axis labels (stages) -->
      <text x="45" y="65" text-anchor="end" class="fill-[var(--color-text-tertiary)] font-semibold" font-family="var(--font-mono)" font-size="10">Stage 0</text>
      <text x="45" y="115" text-anchor="end" class="fill-[var(--color-text-tertiary)] font-semibold" font-family="var(--font-mono)" font-size="10">Stage 1</text>
      <text x="45" y="165" text-anchor="end" class="fill-[var(--color-text-tertiary)] font-semibold" font-family="var(--font-mono)" font-size="10">Stage 2</text>
      <text x="45" y="215" text-anchor="end" class="fill-[var(--color-text-tertiary)] font-semibold" font-family="var(--font-mono)" font-size="10">Stage 3</text>

      <!-- X-axis label -->
      <text x="430" y="250" text-anchor="middle" class="fill-[var(--color-text-tertiary)] font-semibold" font-family="var(--font-mono)" font-size="9">Time →</text>

      <!-- Grid lines -->
      <line x1="55" y1="45" x2="55" y2="230" stroke="var(--color-border)" stroke-width="1.5" />
      <line x1="55" y1="45" x2="790" y2="45" stroke="var(--color-border)" stroke-width="0.5" stroke-dasharray="4,4" />
      <line x1="55" y1="95" x2="790" y2="95" stroke="var(--color-border)" stroke-width="0.5" stroke-dasharray="4,4" />
      <line x1="55" y1="145" x2="790" y2="145" stroke="var(--color-border)" stroke-width="0.5" stroke-dasharray="4,4" />
      <line x1="55" y1="195" x2="790" y2="195" stroke="var(--color-border)" stroke-width="0.5" stroke-dasharray="4,4" />
      <line x1="55" y1="230" x2="790" y2="230" stroke="var(--color-border)" stroke-width="1.5" />

      <!-- Blocks container -->
      <g id="pipeline-blocks"></g>
    </svg>
  </div>

  <!-- Legend -->
  <div class="flex flex-wrap items-center gap-5 mt-6 pt-5 border-t border-[var(--color-border)]">
    <div class="flex items-center gap-2">
      <span class="w-3.5 h-3.5 rounded-md shadow-sm" style="background: url(#fwd-grad) oklch(0.60 0.18 265);"></span>
      <span class="text-xs text-[var(--color-text-secondary)] font-mono font-medium">Forward</span>
    </div>
    <div class="flex items-center gap-2">
      <span class="w-3.5 h-3.5 rounded-md shadow-sm" style="background: url(#bwd-grad) oklch(0.65 0.15 155);"></span>
      <span class="text-xs text-[var(--color-text-secondary)] font-mono font-medium">Backward</span>
    </div>
    <div class="flex items-center gap-2">
      <span class="w-3.5 h-3.5 rounded-md border border-dashed border-[var(--color-border-hover)]" style="background: url(#bubble-pattern) var(--color-surface-secondary);"></span>
      <span class="text-xs text-[var(--color-text-secondary)] font-mono font-medium">Bubble (idle gap)</span>
    </div>
    <div class="ml-auto flex items-center gap-2">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
      <span id="viz-efficiency" class="text-xs font-mono font-bold text-[var(--color-text-primary)]"></span>
    </div>
  </div>
</div>

<script>
  interface Block {
    stage: number;
    start: number;
    duration: number;
    type: 'forward' | 'backward' | 'bubble';
    label?: string;
  }

  const STAGES = 4;
  const MICROBATCHES = 4;
  const BLOCK_W = 45;
  const BLOCK_H = 38;
  const X_OFFSET = 60;
  const Y_OFFSET = 45;
  const STAGE_GAP = 50;

  // Colors mapping
  const FWD_COLOR = 'url(#fwd-grad)';
  const BWD_COLOR = 'url(#bwd-grad)';
  const BUBBLE_COLOR = 'url(#bubble-pattern)';

  // Naive schedule: all forwards first, then all backwards
  function naiveSchedule(): Block[] {
    const blocks: Block[] = [];

    // Forward passes: each micro-batch cascades down stages
    for (let mb = 0; mb < MICROBATCHES; mb++) {
      for (let s = 0; s < STAGES; s++) {
        blocks.push({
          stage: s,
          start: (mb + s) * BLOCK_W,
          duration: BLOCK_W,
          type: 'forward',
          label: `F${mb}`,
        });
      }
    }

    // All forwards finish at time (MICROBATCHES + STAGES - 1) * BLOCK_W
    const bwdStart = (MICROBATCHES + STAGES - 1) * BLOCK_W;

    // Backward passes: cascade from last stage upward
    for (let mb = 0; mb < MICROBATCHES; mb++) {
      for (let s = STAGES - 1; s >= 0; s--) {
        const stageOffset = (STAGES - 1 - s);
        blocks.push({
          stage: s,
          start: bwdStart + (mb + stageOffset) * BLOCK_W,
          duration: BLOCK_W,
          type: 'backward',
          label: `B${mb}`,
        });
      }
    }

    // Add bubbles where stages are idle
    const totalTime = bwdStart + (MICROBATCHES + STAGES - 1) * BLOCK_W;
    for (let s = 0; s < STAGES; s++) {
      const stageBlocks = blocks.filter(b => b.stage === s && b.type !== 'bubble').sort((a, b) => a.start - b.start);
      let cursor = stageBlocks.length > 0 ? stageBlocks[0].start + stageBlocks[0].duration : 0;
      for (let i = 1; i < stageBlocks.length; i++) {
        if (stageBlocks[i].start > cursor) {
          blocks.push({
            stage: s,
            start: cursor,
            duration: stageBlocks[i].start - cursor,
            type: 'bubble',
          });
        }
        cursor = stageBlocks[i].start + stageBlocks[i].duration;
      }
    }

    return blocks;
  }

  // 1F1B schedule: interleaved forward and backward passes
  function oneFOneBSchedule(): Block[] {
    const blocks: Block[] = [];

    // Stage 0 timeline:
    const s0: Block[] = [];
    let t = 0;
    for (let mb = 0; mb < MICROBATCHES; mb++) {
      s0.push({ stage: 0, start: t, duration: BLOCK_W, type: 'forward', label: `F${mb}` });
      t += BLOCK_W;
    }
    for (let mb = 0; mb < MICROBATCHES; mb++) {
      s0.push({ stage: 0, start: t, duration: BLOCK_W, type: 'backward', label: `B${mb}` });
      t += BLOCK_W;
    }

    // Stage 1: delayed by 1 slot, warmup 3 fwd then alternate
    const s1: Block[] = [];
    t = BLOCK_W;
    for (let mb = 0; mb < 3; mb++) {
      s1.push({ stage: 1, start: t, duration: BLOCK_W, type: 'forward', label: `F${mb}` });
      t += BLOCK_W;
    }
    s1.push({ stage: 1, start: t, duration: BLOCK_W, type: 'forward', label: 'F3' }); t += BLOCK_W;
    s1.push({ stage: 1, start: t, duration: BLOCK_W, type: 'backward', label: 'B0' }); t += BLOCK_W;
    s1.push({ stage: 1, start: t, duration: BLOCK_W, type: 'backward', label: 'B1' }); t += BLOCK_W;
    s1.push({ stage: 1, start: t, duration: BLOCK_W, type: 'backward', label: 'B2' }); t += BLOCK_W;
    s1.push({ stage: 1, start: t, duration: BLOCK_W, type: 'backward', label: 'B3' }); t += BLOCK_W;

    // Stage 2: delayed by 2 slots, warmup 2 fwd
    const s2: Block[] = [];
    t = 2 * BLOCK_W;
    s2.push({ stage: 2, start: t, duration: BLOCK_W, type: 'forward', label: 'F0' }); t += BLOCK_W;
    s2.push({ stage: 2, start: t, duration: BLOCK_W, type: 'forward', label: 'F1' }); t += BLOCK_W;
    s2.push({ stage: 2, start: t, duration: BLOCK_W, type: 'forward', label: 'F2' }); t += BLOCK_W;
    s2.push({ stage: 2, start: t, duration: BLOCK_W, type: 'backward', label: 'B0' }); t += BLOCK_W;
    s2.push({ stage: 2, start: t, duration: BLOCK_W, type: 'forward', label: 'F3' }); t += BLOCK_W;
    s2.push({ stage: 2, start: t, duration: BLOCK_W, type: 'backward', label: 'B1' }); t += BLOCK_W;
    s2.push({ stage: 2, start: t, duration: BLOCK_W, type: 'backward', label: 'B2' }); t += BLOCK_W;
    s2.push({ stage: 2, start: t, duration: BLOCK_W, type: 'backward', label: 'B3' }); t += BLOCK_W;

    // Stage 3: delayed by 3 slots, warmup 1 fwd
    const s3: Block[] = [];
    t = 3 * BLOCK_W;
    s3.push({ stage: 3, start: t, duration: BLOCK_W, type: 'forward', label: 'F0' }); t += BLOCK_W;
    s3.push({ stage: 3, start: t, duration: BLOCK_W, type: 'backward', label: 'B0' }); t += BLOCK_W;
    s3.push({ stage: 3, start: t, duration: BLOCK_W, type: 'forward', label: 'F1' }); t += BLOCK_W;
    s3.push({ stage: 3, start: t, duration: BLOCK_W, type: 'backward', label: 'B1' }); t += BLOCK_W;
    s3.push({ stage: 3, start: t, duration: BLOCK_W, type: 'forward', label: 'F2' }); t += BLOCK_W;
    s3.push({ stage: 3, start: t, duration: BLOCK_W, type: 'backward', label: 'B2' }); t += BLOCK_W;
    s3.push({ stage: 3, start: t, duration: BLOCK_W, type: 'forward', label: 'F3' }); t += BLOCK_W;
    s3.push({ stage: 3, start: t, duration: BLOCK_W, type: 'backward', label: 'B3' }); t += BLOCK_W;

    return [...s0, ...s1, ...s2, ...s3];
  }

  function computeEfficiency(blocks: Block[]): number {
    const workBlocks = blocks.filter(b => b.type !== 'bubble');
    if (workBlocks.length === 0) return 0;
    const totalWork = workBlocks.reduce((sum, b) => sum + b.duration, 0);
    const maxEnd = Math.max(...blocks.filter(b => b.type !== 'bubble').map(b => b.start + b.duration));
    const minStart = Math.min(...blocks.filter(b => b.type !== 'bubble').map(b => b.start));
    const totalSpan = (maxEnd - minStart) * STAGES;
    return Math.round((totalWork / totalSpan) * 100);
  }

  function renderBlocks(blocks: Block[], animate: boolean) {
    const container = document.getElementById('pipeline-blocks');
    const svg = document.getElementById('pipeline-svg');
    if (!container || !svg) return;

    container.innerHTML = '';

    // Calculate viewBox width based on blocks
    const workBlocks = blocks.filter(b => b.type !== 'bubble');
    const maxX = Math.max(...workBlocks.map(b => b.start + b.duration)) + X_OFFSET + 10;
    svg.setAttribute('viewBox', `0 0 ${Math.max(800, maxX)} 260`);

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    blocks.forEach((block, i) => {
      const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');

      const x = X_OFFSET + block.start;
      const y = Y_OFFSET + block.stage * STAGE_GAP;

      const rect = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
      rect.setAttribute('x', String(x));
      rect.setAttribute('y', String(y));
      rect.setAttribute('width', String(block.duration - 2));
      rect.setAttribute('height', String(BLOCK_H));
      rect.setAttribute('rx', '5'); // Smoother corners

      if (block.type === 'forward') {
        rect.setAttribute('fill', FWD_COLOR);
      } else if (block.type === 'backward') {
        rect.setAttribute('fill', BWD_COLOR);
      } else {
        rect.setAttribute('fill', BUBBLE_COLOR);
        rect.setAttribute('stroke', 'var(--color-border)');
        rect.setAttribute('stroke-width', '1');
        rect.setAttribute('stroke-dasharray', '3,2');
      }

      if (animate && !reducedMotion) {
        rect.style.opacity = '0';
        rect.style.transform = 'scale(0.95)';
        rect.style.transformOrigin = `${x + block.duration / 2}px ${y + BLOCK_H / 2}px`;
        rect.style.transition = 'opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1), transform 0.4s cubic-bezier(0.16, 1, 0.3, 1)';
        rect.style.transitionDelay = `${i * 0.015}s`;
        
        requestAnimationFrame(() => {
          setTimeout(() => {
            rect.style.opacity = '1';
            rect.style.transform = 'scale(1)';
          }, 20);
        });
      }

      g.appendChild(rect);

      // Label
      if (block.label) {
        const text = document.createElementNS('http://www.w3.org/2000/svg', 'text');
        text.setAttribute('x', String(x + (block.duration - 2) / 2));
        text.setAttribute('y', String(y + BLOCK_H / 2 + 4));
        text.setAttribute('text-anchor', 'middle');
        text.setAttribute('font-family', 'var(--font-mono)');
        text.setAttribute('font-size', '9.5');
        text.setAttribute('font-weight', '700');
        text.setAttribute('fill', 'white');
        // Subtle text drop shadow for clarity
        text.setAttribute('style', 'text-shadow: 0 1px 2px rgba(0,0,0,0.25);');
        text.textContent = block.label;

        if (animate && !reducedMotion) {
          text.style.opacity = '0';
          text.style.transition = 'opacity 0.3s ease';
          text.style.transitionDelay = `${i * 0.015 + 0.15}s`;
          requestAnimationFrame(() => {
            setTimeout(() => {
              text.style.opacity = '1';
            }, 20);
          });
        }

        g.appendChild(text);
      }

      container.appendChild(g);
    });

    // Update efficiency display
    const effEl = document.getElementById('viz-efficiency');
    if (effEl) {
      const eff = computeEfficiency(blocks);
      effEl.textContent = `Efficiency: ~${eff}%`;
    }
  }

  function initViz() {
    const naiveBtn = document.getElementById('viz-btn-naive');
    const onefbBtn = document.getElementById('viz-btn-1f1b');

    function setMode(mode: 'naive' | '1f1b') {
      const blocks = mode === 'naive' ? naiveSchedule() : oneFOneBSchedule();
      renderBlocks(blocks, true);

      // Update button styles to capsule buttons
      const activeClass = 'bg-[var(--color-accent-500)] text-white shadow-sm';
      const inactiveClass = 'text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)]';

      if (naiveBtn && onefbBtn) {
        naiveBtn.className = `viz-toggle-btn px-4.5 py-1.5 rounded-full text-xs font-mono font-bold transition-all cursor-pointer ${mode === 'naive' ? activeClass : inactiveClass}`;
        onefbBtn.className = `viz-toggle-btn px-4.5 py-1.5 rounded-full text-xs font-mono font-bold transition-all cursor-pointer ${mode === '1f1b' ? activeClass : inactiveClass}`;
        naiveBtn.setAttribute('aria-pressed', String(mode === 'naive'));
        onefbBtn.setAttribute('aria-pressed', String(mode === '1f1b'));
      }
    }

    naiveBtn?.addEventListener('click', () => setMode('naive'));
    onefbBtn?.addEventListener('click', () => setMode('1f1b'));

    // Initial render
    setMode('naive');
  }

  initViz();
  document.addEventListener('astro:after-swap', initViz);
</script>
