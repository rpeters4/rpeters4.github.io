---
// Notes section - academic paper notes and future specifications
const notes = [
  {
    title: 'Pipeline Parallelism Schedules',
    description: 'Analysis of GPipe, PipeDream, and zero-bubble schedules. Contrasting naive bubble sizes against 1F1B schedules and highlighting optimization paths.',
    category: 'Paper Notes',
    status: 'Ready',
  },
  {
    title: 'ZeRO Sharding Protocols',
    description: 'Specifying memory savings versus communication volume in ZeRO-1, ZeRO-2, and ZeRO-3 sharding levels. Evaluating redundancy reductions in distributed environments.',
    category: 'Specification Notes',
    status: 'Ready',
  },
  {
    title: 'TLA+ Specifications',
    description: 'A public repository (coming soon) containing formal specifications for collective communication algorithms and distributed training schedules.',
    category: 'Specs Repo',
    status: 'Coming Soon',
  },
];
---

<section id="notes" class="py-24 md:py-32 border-t border-[var(--color-border)] relative">
  <!-- Ambient glow background decoration -->
  <div class="absolute top-1/3 left-10 w-80 h-80 rounded-full blur-[100px] opacity-[0.02] dark:opacity-[0.04] glow-blob-1 pointer-events-none" aria-hidden="true"></div>

  <div class="section-container relative z-10">
    <p class="section-label">Writing</p>
    <h2 class="section-heading">Notes & Specifications</h2>
    <p class="text-sm text-[var(--color-text-secondary)] mb-8 max-w-[62ch]">
      Technical reviews, paper readings, and formal specifications written during systems research and coursework.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {notes.map((note, i) => (
        <div
          class="card group flex flex-col justify-between"
          style={`animation: fade-in-up 0.6s ease-out ${0.1 + i * 0.1}s both;`}
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="font-mono text-[9px] font-bold uppercase tracking-widest px-2 py-0.5 rounded border border-[var(--color-accent-300)]/20 dark:border-[var(--color-accent-700)]/30 bg-[var(--color-accent-500)]/5 text-[var(--color-accent-500)]">
                {note.category}
              </span>
              <span class="font-mono text-[9px] text-[var(--color-text-tertiary)] uppercase tracking-wider font-semibold">
                {note.status}
              </span>
            </div>
            
            <h3 class="font-mono text-sm font-bold text-[var(--color-text-primary)] group-hover:text-[var(--color-accent-500)] transition-colors mb-2.5">
              {note.title}
            </h3>
            
            <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed">
              {note.description}
            </p>
          </div>
          
          <div class="flex items-center gap-1 mt-6 pt-3.5 border-t border-[var(--color-border)]/40 text-xs font-mono font-bold text-[var(--color-text-tertiary)] group-hover:text-[var(--color-accent-500)] transition-colors">
            <span>Read review</span>
            <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
