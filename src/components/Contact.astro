---
// Contact section with copy-to-clipboard for emails
const contacts = [
  {
    label: 'GitHub',
    href: 'https://github.com/rpeters4',
    value: 'rpeters4',
    icon: 'github',
    external: true,
    accent: 'hover:border-neutral-500/30 dark:hover:border-neutral-200/25',
    color: 'text-neutral-700 dark:text-neutral-300',
  },
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/in/rynptrs/',
    value: 'rynptrs',
    icon: 'linkedin',
    external: true,
    accent: 'hover:border-sky-500/30 dark:hover:border-sky-400/25',
    color: 'text-sky-600 dark:text-sky-400',
  },
  {
    label: 'Academic Email',
    href: 'mailto:rpeter01@syr.edu',
    value: 'rpeter01@syr.edu',
    icon: 'email',
    copyable: true,
    accent: 'hover:border-violet-500/30 dark:hover:border-violet-400/25',
    color: 'text-violet-600 dark:text-violet-400',
  },
  {
    label: 'Personal Email',
    href: 'mailto:petersryan1993@gmail.com',
    value: 'petersryan1993@gmail.com',
    icon: 'email',
    copyable: true,
    accent: 'hover:border-emerald-500/30 dark:hover:border-emerald-400/25',
    color: 'text-emerald-600 dark:text-emerald-400',
  },
];
---

<section id="contact" class="py-24 md:py-32 border-t border-[var(--color-border)] relative">
  <div class="section-container">
    <p class="section-label">Contact</p>
    <h2 class="section-heading">Get in Touch</h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 max-w-3xl">
      {contacts.map(contact => (
        <div class={`card flex items-center justify-between gap-4 p-5 hover:-translate-y-1 ${contact.accent}`}>
          <a
            href={contact.href}
            target={contact.external ? '_blank' : undefined}
            rel={contact.external ? 'noopener noreferrer' : undefined}
            class="flex items-center gap-4 flex-1 min-w-0 group cursor-pointer"
          >
            <div class={`w-10 h-10 flex items-center justify-center rounded-xl bg-[var(--color-surface-secondary)] ${contact.color} group-hover:scale-110 transition-transform duration-300`}>
              {contact.icon === 'github' && (
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                </svg>
              )}
              {contact.icon === 'linkedin' && (
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              )}
              {contact.icon === 'email' && (
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              )}
            </div>
            <div class="min-w-0">
              <p class="text-[10px] font-mono uppercase tracking-widest text-[var(--color-text-tertiary)] mb-0.5">{contact.label}</p>
              <p class="text-sm font-bold text-[var(--color-text-primary)] group-hover:text-[var(--color-accent-500)] transition-colors truncate">{contact.value}</p>
            </div>
          </a>
          
          {contact.copyable && (
            <button
              type="button"
              class="copy-btn flex-shrink-0 p-2.5 rounded-xl border border-[var(--color-border)] hover:border-[var(--color-border-hover)] bg-[var(--color-surface-secondary)]/50 hover:bg-[var(--color-surface-card)] hover:shadow-sm hover:scale-105 active:scale-95 transition-all duration-200 cursor-pointer"
              data-copy-value={contact.value}
              aria-label={`Copy ${contact.value} to clipboard`}
              title="Copy to clipboard"
            >
              <svg class="copy-icon w-4 h-4 text-[var(--color-text-tertiary)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
              <svg class="check-icon w-4 h-4 text-emerald-500 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </button>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Footer -->
<footer class="py-12 border-t border-[var(--color-border)] bg-[var(--color-surface-secondary)]/30 backdrop-blur-sm relative z-10">
  <div class="section-container flex flex-col sm:flex-row items-center justify-between gap-4">
    <p class="text-xs text-[var(--color-text-tertiary)] font-mono">
      &copy; {new Date().getFullYear()} Ryan Peters
    </p>
    <p class="text-xs text-[var(--color-text-tertiary)]">
      Built with <a href="https://astro.build" target="_blank" rel="noopener noreferrer" class="font-semibold hover:text-[var(--color-accent-500)] transition-colors">Astro</a> &amp; <a href="https://tailwindcss.com" target="_blank" rel="noopener noreferrer" class="font-semibold hover:text-[var(--color-accent-500)] transition-colors">Tailwind CSS</a>
    </p>
  </div>
</footer>

<script>
  function initCopyButtons() {
    document.querySelectorAll('.copy-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const value = btn.getAttribute('data-copy-value');
        if (!value) return;

        try {
          await navigator.clipboard.writeText(value);
          const copyIcon = btn.querySelector('.copy-icon');
          const checkIcon = btn.querySelector('.check-icon');
          copyIcon?.classList.add('hidden');
          checkIcon?.classList.remove('hidden');

          setTimeout(() => {
            copyIcon?.classList.remove('hidden');
            checkIcon?.classList.add('hidden');
          }, 2000);
        } catch (err) {
          console.warn('Copy failed:', err);
        }
      });
    });
  }

  initCopyButtons();
  document.addEventListener('astro:after-swap', initCopyButtons);
</script>
